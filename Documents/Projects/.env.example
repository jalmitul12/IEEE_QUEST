PORT=3000
NODE_ENV=development
# Required in production. Use a random secret of at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
CLIENT_URL=http://localhost:3000
# Set true only when Aegis is actually behind one trusted reverse proxy.
TRUST_PROXY=false
# Development only. Production never auto-seeds the public demo account.
SEED_DEMO_USER=true
DEMO_PASSWORD=Demo@123
